# ─── Provider ────────────────────────────────────────────────────────────────
# Choose one: groq | gemini | anthropic
# Groq and Gemini are completely free (no credit card required).
PROVIDER=groq

# ─── API keys — only the key for your chosen provider is needed ──────────────

# Groq  →  console.groq.com  (free, no card)
GROQ_API_KEY=gsk_your_key_here

# Gemini → aistudio.google.com/apikey  (free, no card)
# GEMINI_API_KEY=AIza_your_key_here

# Anthropic (paid)
# ANTHROPIC_API_KEY=sk-ant-your_key_here

# ─── Optional model override ──────────────────────────────────────────────────
# Leave blank to use the default for your provider
# Groq default:       llama-3.1-8b-instant
# Gemini default:     gemini-2.0-flash
# Anthropic default:  claude-haiku-4-5
# GENERATOR_MODEL=

# ─── Storage ──────────────────────────────────────────────────────────────────
DB_PATH=data/research.db
CHROMA_PATH=data/chroma

# ─── Pipeline settings ────────────────────────────────────────────────────────
MAX_SOURCES_PER_SUBQUESTION=3
MAX_SUBQUESTIONS=5
CONFIDENCE_THRESHOLD=0.3
SCRAPER_TIMEOUT=15
MAX_RETRIES=2
